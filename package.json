{
  "type": "module",
  "dependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "dotenv": "^17.4.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "test:prod": "set ENV=prod && npx playwright test",
    "test:smokeTest": "npx playwright test -g @smoke",
    "test:regressionTest": "npx playwright test -g @regression",
    "test:smokeAndRegression": "npx playwright test --grep (?=.*@smoke)(?=.*@regression)"
  }
}
